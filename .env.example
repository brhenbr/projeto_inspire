# Copie este arquivo para ".env" (na raiz do repositório) e preencha SÓ o que for usar.
# O arquivo .env é ignorado pelo git. NUNCA commite chaves.
#
# Para testar com o pacote de teste (base já carregada) NÃO é preciso preencher nada:
# o sistema sobe com a IA em modo simulado (sem internet). Guia: docs/guia/README.md

# Chave de API do dados.gov.br (perfil Consumidor).
# Obtenha em dados.gov.br > Minha Conta.
DADOS_GOV_API_KEY=

# URL base da API (produção). Homologação: https://hmg.dados.gov.br
DADOS_GOV_BASE_URL=https://dados.gov.br

# Senha do PostgreSQL local (docker compose). Em desenvolvimento há um padrão; defina outra fora disso.
POSTGRES_PASSWORD=

# --- Taxa de chamadas ao portal (o portal bloqueia com HTTP 405 se chamado rápido demais)
PORTAL_MAX_RPS=4

# --- LLM (curadoria assistida). 'simulado' não usa IA nem rede: serve para demonstrar o fluxo.
# Para um provedor real: LLM_PROVIDER=openai-compatible, LLM_BASE_URL, LLM_MODEL, LLM_API_KEY e o host em
# LLM_ALLOWED_HOSTS. Só campos públicos do catálogo são enviados (ADR-0004). Veja docs/03-decisoes/0011.
LLM_ENABLED=true
LLM_PROVIDER=simulado
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_ALLOWED_HOSTS=localhost,127.0.0.1,llm-local

# Roteador de provedores gratuitos (ADR-0014): LLM_PROVIDER=roteador. A lista abaixo é a aprovação dos provedores
# (ADR-0004), na ordem de preferência. Provedor sem chave é ignorado; ao estourar a cota de um, usa o próximo.
# Opcional: LLM_<NOME>_MODEL (ex.: LLM_GROQ_MODEL) troca o modelo padrão do provedor.
LLM_ROUTER_PROVIDERS=groq,gemini,openrouter,cerebras,mistral,deepseek
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
